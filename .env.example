# QFF 2026 — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public site URL, used for metadata/Open Graph absolute URLs.
# Absolute origin used for Open Graph / Twitter cards and canonical URLs.
# On Vercel this is detected automatically; set it only for a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# The variables below are NOT required by the current landing page.
# They're documented here so the shape of the future config is visible early,
# but nothing in this codebase reads them yet.
# ---------------------------------------------------------------------------

# DATABASE_URL=                # PostgreSQL connection string (Prisma), added with the courses/registration platform
# NEXTAUTH_SECRET=             # Session/auth secret, added with authentication
# NEXTAUTH_URL=                # Auth callback base URL
# VIDEO_PROVIDER_API_KEY=      # Cloudflare Stream / Mux API key, added with course video
# QR_TOKEN_SECRET=             # Signing secret for short-lived attendance QR tokens
